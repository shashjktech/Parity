{
  "expo": {
    "name": "Parity",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android/foreground.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android/foreground.png",
        "backgroundImage": "./assets/images/android/background.png"
      },
      "predictiveBackGestureEnabled": false,
      "useCleartextTraffic": true,
      "package": "com.parity.property",
      "googleServicesFile": "./google-services.json"


    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow this app to use your location to auto-fill your property address."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Parity to take a photo of a room, area, or asset."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"


    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
